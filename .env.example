# Veyloom settings. `veyloom serve` writes this file as ./.env on its first
# run, so there is nothing to copy: edit .env and restart. Every command
# reads .env into the environment first; a variable already set in the
# shell wins. --env-file names another file, and an empty one means none.
# The values below are the defaults.

# Local state: machine identity, account and sessions, transcripts, attachments,
# agent avatars.
VEYLOOM_STATE_DIR=~/.veyloom

# Postgres, as started by `docker compose up -d`.
VEYLOOM_DATABASE_URL=postgres://veyloom:veyloom@localhost:5432/veyloom?sslmode=disable

# Where the API listens.
VEYLOOM_SERVER_ADDR=127.0.0.1:7788

# Origins allowed to call the API across origins (comma-separated host
# patterns, e.g. "app.example.com,localhost:*"). Empty when the web client
# is served from the same origin or proxies /api, which is the usual setup.
VEYLOOM_SERVER_ALLOWED_ORIGINS=

# Where the web dev server (make web-dev) and vite preview proxy /api to.
VEYLOOM_API=http://127.0.0.1:7788

# Only for a cross-origin deployment: the API's base URL baked into the
# web client at build time. Leave empty to proxy /api instead.
VITE_API_BASE=
